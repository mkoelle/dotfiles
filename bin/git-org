#!/usr/bin/env python3
"""
git-org: clone/sync all repos for an org/group into a Go-like workspace layout.

Layout:
  ~/src/<host>/<team>/<repo>
  GitLab subgroup projects retain their full group/subgroup path:
  ~/src/<host>/<group>/<subgroup>/.../<repo>

Examples:
  git-org clone github my-org --proto ssh
  git-org clone gitlab platform/observability --host gitlab.com --proto https
  git-org list  github my-org

  # Auto-detect from cwd (when inside ~/src/<host>/<team>/...):
  cd ~/src/github.com/my-org/some-repo
  git-org sync
  git-org list

Auth precedence:
  GITHUB_TOKEN / GITLAB_TOKEN env var  >  unauthenticated
"""

from __future__ import annotations

import argparse
import json
import os
import pathlib
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request


def eprint(*args, **kwargs):
    print(*args, file=sys.stderr, **kwargs)


def http_json(url: str, headers: dict[str, str], timeout: int = 30):
    req = urllib.request.Request(url, headers=headers)
    with urllib.request.urlopen(req, timeout=timeout) as resp:
        body = resp.read()
        return json.loads(body.decode("utf-8"))


def run(cmd: list[str], cwd: pathlib.Path | None = None):
    subprocess.run(cmd, cwd=cwd, check=True)


def ensure_dir(p: pathlib.Path):
    p.mkdir(parents=True, exist_ok=True)


def fetch_paginated(
    url: str,
    headers: dict[str, str],
    per_page: int,
    page_delay: float = 0,
) -> list[dict]:
    results: list[dict] = []
    while True:
        data = http_json(url, headers=headers)
        if not isinstance(data, list):
            raise RuntimeError(f"Unexpected API response: {data}")
        results.extend(data)
        if len(data) < per_page:
            return results

        parsed = urllib.parse.urlparse(url)
        query = urllib.parse.parse_qs(parsed.query)
        page = int(query.get("page", ["1"])[0])
        query["page"] = [str(page + 1)]
        url = parsed._replace(
            query=urllib.parse.urlencode({key: values[0] for key, values in query.items()})
        ).geturl()
        if page_delay:
            time.sleep(page_delay)


def git_clone_or_fetch(repo_url: str, dest: pathlib.Path):
    if dest.exists() and (dest / ".git").exists():
        eprint(f"[fetch] {dest}")
        run(["git", "-C", str(dest), "fetch", "--all", "--prune"])
        return

    ensure_dir(dest.parent)
    eprint(f"[clone] {repo_url} -> {dest}")
    run(["git", "clone", repo_url, str(dest)])


# ---------------------------------------------------------------------------
# Provider detection
# ---------------------------------------------------------------------------

HOST_PROVIDER_MAP: list[tuple[str, str]] = [
    ("github", "github"),
    ("gitlab", "gitlab"),
]


def _match_provider_by_name(host: str) -> str | None:
    """Instant match when the hostname contains a known provider name."""
    lower = host.lower()
    for substr, prov in HOST_PROVIDER_MAP:
        if substr in lower:
            return prov
    return None


def _probe_provider(host: str) -> str | None:
    """Hit well-known API endpoints; even a 401/403 confirms the provider."""
    probes = [
        (f"https://{host}/api/v4/version", "gitlab"),
        (f"https://{host}/api/v3",          "github"),
    ]
    for url, provider in probes:
        try:
            req = urllib.request.Request(url, headers={"User-Agent": "git-org"})
            urllib.request.urlopen(req, timeout=5)
            return provider
        except urllib.error.HTTPError as e:
            if e.code < 404:
                return provider
        except Exception:
            pass
    return None


def detect_provider_from_host(host: str) -> str | None:
    """Identify provider: fast name match first, then network probe."""
    prov = _match_provider_by_name(host)
    if prov:
        return prov
    eprint(f"[auto] probing {host} to identify provider…")
    prov = _probe_provider(host)
    if prov:
        eprint(f"[auto] detected {prov} via API probe")
    return prov


def detect_from_cwd(root: str) -> tuple[str | None, str | None, str | None]:
    """Detect (provider, team, host) from cwd.

    Expects:  <root>/<host>/<team>[/<repo>/...]
    """
    cwd = pathlib.Path.cwd().resolve()
    root_path = pathlib.Path(root).expanduser().resolve()

    try:
        rel = cwd.relative_to(root_path)
    except ValueError:
        return None, None, None

    parts = rel.parts
    if len(parts) < 2:
        return None, None, None

    host = parts[0]
    team = parts[1]
    provider = detect_provider_from_host(host)

    return provider, team, host


# ---------------------------------------------------------------------------
# Providers
# ---------------------------------------------------------------------------

class Provider:
    name: str

    def __init__(self, host: str, token: str | None, proto: str):
        self.host = host
        self.token = token
        self.proto = proto

    def list_repos(self, team: str) -> list[dict]:
        raise NotImplementedError

    def pick_clone_url(self, repo: dict) -> str:
        raise NotImplementedError


class GitHubProvider(Provider):
    name = "github"

    def list_repos(self, team: str) -> list[dict]:
        headers = {
            "Accept": "application/vnd.github+json",
            "User-Agent": "git-org",
        }
        if self.token:
            headers["Authorization"] = f"Bearer {self.token}"

        base = "https://api.github.com"
        per_page = 100
        encoded_team = urllib.parse.quote(team, safe="")
        org_url = f"{base}/orgs/{encoded_team}/repos?per_page={per_page}&page=1&type=all"
        user_url = f"{base}/users/{encoded_team}/repos?per_page={per_page}&page=1&type=all"

        try:
            return fetch_paginated(org_url, headers, per_page)
        except urllib.error.HTTPError as ex:
            if ex.code != 404:
                raise
            return fetch_paginated(user_url, headers, per_page)

    def pick_clone_url(self, repo: dict) -> str:
        return repo["ssh_url"] if self.proto == "ssh" else repo["clone_url"]


class GitLabProvider(Provider):
    name = "gitlab"

    def list_repos(self, team: str) -> list[dict]:
        if not self.host:
            raise RuntimeError("GitLab host is required (e.g., gitlab.com or gitlab.myco.com)")

        headers = {"User-Agent": "git-org"}
        if self.token:
            headers["PRIVATE-TOKEN"] = self.token

        per_page = 100
        base = f"https://{self.host}/api/v4"

        group = urllib.parse.quote(team, safe="")
        url = (
            f"{base}/groups/{group}/projects"
            f"?include_subgroups=true&per_page={per_page}&page=1&simple=true"
        )

        return fetch_paginated(url, headers, per_page, page_delay=0.05)

    def pick_clone_url(self, repo: dict) -> str:
        return repo["ssh_url_to_repo"] if self.proto == "ssh" else repo["http_url_to_repo"]


PROVIDERS = {
    "github": GitHubProvider,
    "gitlab": GitLabProvider,
}


def resolve_provider(provider_name: str, host: str | None, proto: str) -> Provider:
    if provider_name not in PROVIDERS:
        raise RuntimeError(f"Unknown provider: {provider_name}")

    if not host:
        host = "github.com" if provider_name == "github" else "gitlab.com"

    token = None
    if provider_name == "github":
        token = os.environ.get("GITHUB_TOKEN")
    elif provider_name == "gitlab":
        token = os.environ.get("GITLAB_TOKEN")

    return PROVIDERS[provider_name](host=host, token=token, proto=proto)


def repo_name(repo: dict) -> str:
    return repo.get("name") or repo.get("path") or repo.get("path_with_namespace", "").split("/")[-1]


def repo_destination(root: pathlib.Path, provider: Provider, team: str, repo: dict) -> pathlib.Path:
    namespace = repo.get("path_with_namespace") or repo.get("full_name")
    if not namespace:
        namespace = f"{team}/{repo_name(repo)}"
    if not isinstance(namespace, str):
        raise RuntimeError(f"Invalid repository namespace: {namespace!r}")

    parts = namespace.split("/")
    if any(part in ("", ".", "..") for part in parts):
        raise RuntimeError(f"Invalid repository namespace: {namespace!r}")

    return root / provider.host / pathlib.Path(*parts)


# ---------------------------------------------------------------------------
# Resolve args: explicit > detected from cwd > error
# ---------------------------------------------------------------------------

def resolve_args(args) -> None:
    """Fill in provider / team / host from cwd when not given explicitly."""
    det_provider, det_team, det_host = detect_from_cwd(args.root)

    if not args.provider:
        if det_provider:
            args.provider = det_provider
            eprint(f"[auto] provider={args.provider}  (detected from cwd)")
        else:
            raise RuntimeError(
                "Could not detect provider from cwd. "
                "Supply it explicitly:  git-org <cmd> <provider> <team>"
            )

    if not args.team:
        if det_team:
            args.team = det_team
            eprint(f"[auto] team={args.team}  (detected from cwd)")
        else:
            raise RuntimeError(
                "Could not detect team from cwd. "
                "Supply it explicitly:  git-org <cmd> <provider> <team>"
            )

    if not args.host and det_host:
        args.host = det_host
        eprint(f"[auto] host={args.host}  (detected from cwd)")


# ---------------------------------------------------------------------------
# Commands
# ---------------------------------------------------------------------------

def cmd_list(args) -> int:
    resolve_args(args)
    provider = resolve_provider(args.provider, args.host, args.proto)
    repos = provider.list_repos(args.team)

    if not args.include_archived:
        repos = [r for r in repos if not bool(r.get("archived", False))]

    for r in repos:
        name = repo_name(r)
        if name:
            print(name)
    return 0


def cmd_clone_or_sync(args) -> int:
    resolve_args(args)
    provider = resolve_provider(args.provider, args.host, args.proto)
    root = pathlib.Path(args.root).expanduser().resolve()

    repos = provider.list_repos(args.team)
    if not args.include_archived:
        repos = [r for r in repos if not bool(r.get("archived", False))]

    eprint(f"Found {len(repos)} repos on {args.provider} host={provider.host} team={args.team}")

    for r in repos:
        name = repo_name(r)
        if not name:
            eprint(f"Skipping repo with no name: {r}")
            continue

        clone_url = provider.pick_clone_url(r)
        dest = repo_destination(root, provider, args.team, r)

        if args.dry_run:
            print(f"{clone_url} -> {dest}")
        else:
            git_clone_or_fetch(clone_url, dest)

    return 0


# ---------------------------------------------------------------------------
# CLI
# ---------------------------------------------------------------------------

def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog="git-org",
        description="Clone/sync repos into ~/src/<host>/<namespace>/<repo>, preserving provider namespace paths.",
        formatter_class=argparse.RawTextHelpFormatter,
    )

    sub = p.add_subparsers(dest="command")

    def add_common(sp):
        sp.add_argument(
            "provider",
            nargs="?",
            default=None,
            choices=sorted(PROVIDERS.keys()),
            help="Provider: github | gitlab  (auto-detected from cwd when omitted)",
        )
        sp.add_argument(
            "team",
            nargs="?",
            default=None,
            help="GitHub org/user OR GitLab group  (auto-detected from cwd when omitted)",
        )
        sp.add_argument("--host", default=None, help="VCS host (default: github.com or gitlab.com)")
        sp.add_argument("--proto", choices=["ssh", "https"], default="ssh", help="Clone protocol (default: ssh)")
        sp.add_argument("--root", default=os.path.expanduser("~/src"), help="Workspace root (default: ~/src)")
        sp.add_argument("--include-archived", action="store_true", help="Include archived repos/projects")
        sp.add_argument("--dry-run", action="store_true", help="Print actions without cloning/fetching")

    sp_clone = sub.add_parser("clone", help="Clone repos; fetch if already cloned")
    add_common(sp_clone)
    sp_clone.set_defaults(func=cmd_clone_or_sync)

    sp_sync = sub.add_parser("sync", help="Alias for clone (fetches existing, clones missing)")
    add_common(sp_sync)
    sp_sync.set_defaults(func=cmd_clone_or_sync)

    sp_list = sub.add_parser("list", help="List repo names for the org/group")
    add_common(sp_list)
    sp_list.set_defaults(func=cmd_list)

    return p


def main(argv: list[str]) -> int:
    parser = build_parser()

    if len(argv) == 0:
        parser.print_help(sys.stdout)
        return 0

    args = parser.parse_args(argv)

    if not getattr(args, "command", None):
        parser.print_help(sys.stdout)
        return 0

    try:
        return args.func(args)
    except KeyboardInterrupt:
        eprint("Interrupted.")
        return 130
    except Exception as ex:
        eprint(f"Error: {ex}")
        return 1


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))